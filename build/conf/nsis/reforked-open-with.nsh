!define REFORKED_FILE_PROGID "Reforked.File"

!macro RegisterReforkedExtension Extension
  WriteRegStr SHCTX "Software\Classes\Applications\${PRODUCT_EXE_FILE}\SupportedTypes" "${Extension}" ""
  WriteRegStr SHCTX "Software\Classes\${Extension}\OpenWithProgids" "${REFORKED_FILE_PROGID}" ""
!macroend

!macro UnregisterReforkedExtension Extension
  DeleteRegValue SHCTX "Software\Classes\${Extension}\OpenWithProgids" "${REFORKED_FILE_PROGID}"
!macroend

